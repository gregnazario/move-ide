# ---- Backend (Axum) — backend/.env or docker-compose environment ----

# HMAC secret used to sign the mp_auth session cookie (set a real secret in
# production; generate one with scripts/gen-auth-secret.sh)
AUTH_JWT_SECRET=change-me

# Comma-separated allow-list of browser origins
PLAYGROUND_FRONTEND_ORIGINS=http://localhost:3000

# Listen address / port
PLAYGROUND_HOST=0.0.0.0
PLAYGROUND_PORT=8080

# Per-execution limits
PLAYGROUND_TIMEOUT_SECS=60        # hard timeout per command
PLAYGROUND_MAX_MEMORY_MB=1024     # address-space cap — Linux only (RLIMIT_AS); ignored on macOS
PLAYGROUND_MAX_DISK_MB=100        # max bytes written per file
PLAYGROUND_CONCURRENT_PER_IP=2    # concurrent executions per client IP

# Honor X-Forwarded-For / X-Real-IP behind a reverse proxy (affects rate limiting)
PLAYGROUND_TRUST_PROXY_HEADERS=false

# GitHub personal access token used to create/read Gist shares (optional)
GITHUB_TOKEN=

RUST_LOG=info

# ---- Frontend ----

# Build-time base URL of a cross-origin backend. Leave empty for local dev
# (same-origin through the Vite dev proxy).
# VITE_BACKEND_URL=https://api.example.com

# Dev-only override for the Vite proxy target when the backend runs on a
# non-default port:
# PLAYGROUND_BACKEND_ORIGIN=http://127.0.0.1:39221
