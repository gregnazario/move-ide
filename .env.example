# Backend (Axum) — set on VPS / docker-compose
AUTH_JWT_SECRET=change-me
PLAYGROUND_FRONTEND_ORIGINS=http://localhost:3000

# Frontend / Vercel Functions — set in Vercel environment variables
FRONTEND_ORIGINS=http://localhost:3000
AUTH_COOKIE_DOMAIN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APTOS_CLI_PATH=aptos

# Production: backend URL for cross-origin API calls (leave empty for same-origin / local dev)
# Set as a Vercel environment variable so it is baked into the frontend build.
# VITE_BACKEND_URL=https://api.move-playground.sed.fyi

# Production: cookie domain for cross-subdomain auth (Vercel env var)
# Allows the auth cookie set at move-playground.sed.fyi to be sent to api.move-playground.sed.fyi
# AUTH_COOKIE_DOMAIN=.move-playground.sed.fyi
