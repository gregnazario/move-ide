{
    "root": true,
    "$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!**/frontend/dist",
            "!**/frontend/node_modules"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
